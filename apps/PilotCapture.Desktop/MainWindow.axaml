<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:PilotCapture.Desktop"
        x:Class="PilotCapture.Desktop.MainWindow"
        Title="VolumePilot | Pilot Capture"
        Background="{DynamicResource VpCloudBrush}"
        FontFamily="Segoe UI"
        Width="1280" Height="940"
        MinWidth="960" MinHeight="800">
  <Grid RowDefinitions="Auto,*">
    <Border Grid.Row="0" Padding="24,14" Background="{DynamicResource VpNavyBrush}">
      <StackPanel Orientation="Horizontal" Spacing="18" VerticalAlignment="Center">
        <TextBlock Text="VolumePilot" FontSize="24" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
        <Border Width="1" Height="34" Background="#64748B" />
        <StackPanel Spacing="2" VerticalAlignment="Center">
          <TextBlock Text="PILOT CAPTURE" FontSize="14" FontWeight="Bold" Foreground="White" />
          <TextBlock Text="0.1 · FIRST FLIGHT" FontSize="12" Foreground="#D7E3F2" />
        </StackPanel>
      </StackPanel>
    </Border>

    <TabControl x:Name="MainTabs" Grid.Row="1" Margin="20">
      <TabItem Header="Roster">
      <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" RowSpacing="14">
      <Grid Grid.Row="0" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="14" RowSpacing="10">
        <StackPanel Spacing="5">
          <TextBlock Text="Roster intake" FontSize="26" FontWeight="SemiBold" />
          <TextBlock Text="Review the column mapping and possible name matches before saving the roster locally." TextWrapping="Wrap" Opacity="0.75" />
        </StackPanel>
        <Button Grid.Column="1" x:Name="OpenRosterButton" Content="Choose roster CSV…" Padding="18,10" VerticalAlignment="Center" Click="OnOpenRosterClick" />
        <TextBox Grid.Row="1" x:Name="EventName" PlaceholderText="Event name (required)" />
        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="8">
          <Button Classes="primary-action" x:Name="ImportRosterButton" Content="Import roster" Padding="18,8" IsEnabled="False" Click="OnImportRosterClick" />
        </StackPanel>
      </Grid>

      <Border Grid.Row="1" Padding="16" CornerRadius="8" BorderBrush="#DCE3ED" Background="White" BorderThickness="1">
        <StackPanel Spacing="12">
          <TextBlock Text="Column mapping" FontSize="18" FontWeight="SemiBold" />
          <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto" ColumnSpacing="14" RowSpacing="10">
            <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4">
              <TextBlock Text="First name" />
              <ComboBox x:Name="FirstNameColumn" IsEnabled="False" SelectionChanged="OnColumnMappingChanged" />
            </StackPanel>
            <StackPanel Grid.Row="0" Grid.Column="1" Spacing="4">
              <TextBlock Text="Last name" />
              <ComboBox x:Name="LastNameColumn" IsEnabled="False" SelectionChanged="OnColumnMappingChanged" />
            </StackPanel>
            <StackPanel Grid.Row="0" Grid.Column="2" Spacing="4">
              <TextBlock Text="Team / school" />
              <ComboBox x:Name="TeamOrSchoolColumn" IsEnabled="False" SelectionChanged="OnColumnMappingChanged" />
            </StackPanel>
            <StackPanel Grid.Row="1" Grid.Column="0" Spacing="4">
              <TextBlock Text="Sport / group" />
              <ComboBox x:Name="SportOrGroupColumn" IsEnabled="False" SelectionChanged="OnColumnMappingChanged" />
            </StackPanel>
            <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
              <TextBlock Text="Roster number" />
              <ComboBox x:Name="RosterNumberColumn" IsEnabled="False" SelectionChanged="OnColumnMappingChanged" />
            </StackPanel>
            <StackPanel Grid.Row="1" Grid.Column="2" Spacing="4">
              <TextBlock Text="Class / category (preserved)" />
              <ComboBox x:Name="ClassOrCategoryColumn" IsEnabled="False" SelectionChanged="OnColumnMappingChanged" />
            </StackPanel>
          </Grid>
        </StackPanel>
      </Border>

      <StackPanel Grid.Row="2" Spacing="4">
        <TextBlock x:Name="RosterSummary" FontWeight="SemiBold" Text="Choose a CSV file to start a preview." />
        <TextBlock x:Name="RosterWarnings" TextWrapping="Wrap" Foreground="#8A4B00" />
      </StackPanel>

      <Border Grid.Row="3" Padding="12" CornerRadius="8" BorderBrush="#D0D0D0" BorderThickness="1" MaxHeight="140">
        <StackPanel Spacing="6">
          <TextBlock Text="Review possible same-name matches (unchecked by default)" FontWeight="SemiBold" />
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="MatchReviewPanel" Spacing="3" />
          </ScrollViewer>
        </StackPanel>
      </Border>

      <Border Grid.Row="4" Padding="12" CornerRadius="8" BorderBrush="#D0D0D0" BorderThickness="1">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
          <ItemsControl x:Name="RosterPreviewRows">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding}" FontFamily="monospace" Margin="2,4" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Border>
      </Grid>
      </TabItem>

      <TabItem Header="Session &amp; files">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16" Margin="12">
          <TextBlock Text="Team and Individual Photoday" FontSize="26" FontWeight="SemiBold" />
          <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="12">
            <StackPanel Spacing="4"><TextBlock Text="Job" /><ComboBox x:Name="CaptureEventCombo" SelectionChanged="OnCaptureEventChanged" /></StackPanel>
            <StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="Photographer" /><TextBox x:Name="PhotographerName" PlaceholderText="Photographer name" /></StackPanel>
            <StackPanel Grid.Column="2" Spacing="4"><TextBlock Text="Capture station" /><ComboBox x:Name="StationCodeCombo" SelectionChanged="OnStationCodeChanged" /></StackPanel>
            <StackPanel Grid.Row="1" Spacing="4"><TextBlock Text="Workflow" /><ComboBox x:Name="WorkflowTypeCombo" /></StackPanel>
            <Button Grid.Row="1" Grid.Column="1" Classes="primary-action" x:Name="StartSessionButton" Content="Start session" Click="OnStartSessionClick" />
            <Button Grid.Row="1" Grid.Column="2" x:Name="EndSessionButton" Content="End session" IsEnabled="False" Click="OnEndSessionClick" />
            <TextBlock Grid.Row="2" Grid.ColumnSpan="3" x:Name="SessionStatus" Text="No active capture session." TextWrapping="Wrap" />
            <Button Grid.Row="3" x:Name="ExportRosterButton" Content="Export new roster…" IsEnabled="False" Click="OnExportRosterClick" />
            <Button Grid.Row="3" Grid.Column="1" x:Name="ExportAssociationsButton" Content="Export image associations…" IsEnabled="False" Click="OnExportImageAssociationsClick" />
          </Grid>
          <Border Padding="14" Background="White" CornerRadius="8">
            <StackPanel Spacing="8">
              <TextBlock Text="Smart Shooter 5 JPEG output folder" FontWeight="SemiBold" />
              <TextBox x:Name="SmartShooterFolderPath" IsReadOnly="True" PlaceholderText="Choose the JPEG output folder" />
              <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Content="Choose folder…" Click="OnChooseSmartShooterFolderClick" />
                <Button x:Name="MonitorFolderButton" Content="Start monitoring" IsEnabled="False" Click="OnMonitorFolderClick" />
              </StackPanel>
              <TextBlock x:Name="ImageIngestStatus" Text="JPEGs are kept locally and copied to the master folder when it is available." TextWrapping="Wrap" />
            </StackPanel>
          </Border>
          <Border Padding="14" Background="White" CornerRadius="8">
            <StackPanel Spacing="10">
              <TextBlock Text="Master VP database folder" FontSize="20" FontWeight="SemiBold" />
              <TextBox x:Name="MasterFolderPath" IsReadOnly="True" PlaceholderText="Fixed server or master PC folder" />
              <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Content="Choose master folder…" Click="OnChooseMasterFolderClick" />
                <Button Content="Publish originals / retry" Click="OnPublishOriginalsClick" />
                <Button Content="Associate edited PNGs" Click="OnAssociateEditedClick" />
              </StackPanel>
              <TextBlock x:Name="MediaStatus" Text="Local originals remain available during a server outage." TextWrapping="Wrap" />
              <TextBlock Text="Export images" FontSize="20" FontWeight="SemiBold" />
              <ComboBox x:Name="ExportKindCombo" />
              <Button Classes="primary-action" Content="Export job folder…" Click="OnExportJobClick" />
            </StackPanel>
          </Border>
        </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem x:Name="ImageReviewTab" Header="Capture">
        <Grid RowDefinitions="Auto,*,220,64" RowSpacing="10" Margin="8">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <StackPanel Spacing="2">
              <TextBlock x:Name="ReviewSubjectTitle" Text="Team and Individual capture" FontSize="24" FontWeight="SemiBold" />
              <TextBlock x:Name="ReviewStatus" Text="Start a session, then select an athlete." TextWrapping="Wrap" />
            </StackPanel>
            <TextBlock Grid.Column="1" x:Name="AthleteCount" FontSize="18" VerticalAlignment="Center" />
          </Grid>
          <Grid Grid.Row="1" ColumnDefinitions="2*,3*" ColumnSpacing="20">
            <Border Padding="10" Background="White" CornerRadius="8">
              <Grid RowDefinitions="*,Auto" RowSpacing="8">
                <Image x:Name="SelectedImagePreview" Stretch="Uniform" HorizontalAlignment="Center" />
                <TextBlock Grid.Row="1" x:Name="SelectedImageStatus" Text="Most recent image / expression closeup" TextWrapping="Wrap" FontSize="16" />
              </Grid>
            </Border>
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
              <StackPanel Spacing="8">
                <TextBlock Text="League / division" FontWeight="SemiBold" />
                <ComboBox x:Name="LeagueCombo" SelectionChanged="OnLeagueChanged" />
                <TextBox x:Name="TeamSearchBox" PlaceholderText="Search teams…" TextChanged="OnTeamSearchChanged" />
                <ComboBox x:Name="CaptureGroupCombo" SelectionChanged="OnCaptureGroupChanged" FontSize="20" />
                <TextBox x:Name="SubjectSearchBox" PlaceholderText="Search this job by name, number or team…" TextChanged="OnSubjectSearchChanged" />
                <ListBox x:Name="SubjectSearchResults" IsVisible="False" MaxHeight="180" SelectionChanged="OnSearchResultSelected" />
                <ComboBox x:Name="CaptureSubjectCombo" FontSize="20" SelectionChanged="OnAthleteSelectionChanged" />
                <Button Classes="primary-action" x:Name="SelectSubjectButton" Content="Select athlete" IsEnabled="False" Click="OnSelectSubjectClick" />
                <TextBlock x:Name="SelectedCaptureSubject" Text="No subject selected." TextWrapping="Wrap" FontSize="18" />
                <Button Classes="forward-action" x:Name="NextSubjectButton" Content="Complete subject · next unphotographed" MinHeight="64" FontSize="20" IsEnabled="False" Click="OnNextSubjectClick" />
                <Expander Header="Add new / unrostered subject">
                  <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="6">
                      <TextBox x:Name="ManualFirstName" PlaceholderText="First name (optional)" />
                      <TextBox Grid.Column="1" x:Name="ManualLastName" PlaceholderText="Last name (optional)" />
                      <TextBox Grid.Row="1" x:Name="ManualRosterNumber" PlaceholderText="Number (optional)" />
                      <TextBox Grid.Row="1" Grid.Column="1" x:Name="ManualRole" PlaceholderText="Class / position (optional)" />
                    </Grid>
                    <Button x:Name="CreateManualSubjectButton" Content="Add and select subject" IsEnabled="False" Click="OnCreateManualSubjectClick" />
                    <TextBox x:Name="UnidentifiedSubjectName" PlaceholderText="Temporary label, such as Walk-in 1" />
                    <Button x:Name="CreateUnidentifiedButton" Content="Add unidentified" IsEnabled="False" Click="OnCreateUnidentifiedClick" />
                  </StackPanel>
                </Expander>
              </StackPanel>
            </ScrollViewer>
          </Grid>
          <ListBox x:Name="CaptureImagesList" Grid.Row="2" SelectionChanged="OnReviewImageSelectionChanged"
                   ScrollViewer.HorizontalScrollBarVisibility="Visible" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                   ScrollViewer.AllowAutoHide="False">
            <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="local:CaptureImageReviewRow">
                <StackPanel Width="116" Spacing="4" Margin="4">
                  <Border Width="102" Height="136" Background="#0B1F3A"><Image Source="{Binding Thumbnail}" Stretch="Uniform" /></Border>
                  <TextBlock Text="{Binding Caption}" TextWrapping="Wrap" FontSize="13" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <Grid Grid.Row="3" ColumnDefinitions="*,*,*,*" ColumnSpacing="12">
            <Button x:Name="SetPrimaryButton" Content="Primary" HorizontalAlignment="Stretch" FontSize="20" IsEnabled="False" Click="OnSetPrimaryClick" />
            <Button Grid.Column="1" x:Name="SetSecondaryButton" Content="Secondary" HorizontalAlignment="Stretch" FontSize="20" IsEnabled="False" Click="OnSetSecondaryClick" />
            <Button Grid.Column="2" x:Name="ToggleBannerButton" Content="Banner" HorizontalAlignment="Stretch" FontSize="20" IsEnabled="False" Click="OnToggleBannerClick" />
            <Button Grid.Column="3" x:Name="RejectImageButton" Content="Reject" HorizontalAlignment="Stretch" FontSize="20" IsEnabled="False" Click="OnRejectImageClick" />
          </Grid>
        </Grid>
      </TabItem>
    </TabControl>
  </Grid>
</Window>
