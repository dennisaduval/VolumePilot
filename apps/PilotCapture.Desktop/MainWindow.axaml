<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:PilotCapture.Desktop"
        x:Class="PilotCapture.Desktop.MainWindow"
        Title="VolumePilot | Pilot Capture"
        Background="{DynamicResource VpCloudBrush}"
        FontFamily="Segoe UI"
        Width="1200" Height="760"
        MinWidth="960" MinHeight="640">
  <Grid RowDefinitions="Auto,*">
    <Border Grid.Row="0" Padding="24,14" Background="{DynamicResource VpNavyBrush}">
      <StackPanel Orientation="Horizontal" Spacing="18" VerticalAlignment="Center">
        <TextBlock Text="VolumePilot" FontSize="24" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
        <Border Width="1" Height="34" Background="#64748B" />
        <StackPanel Spacing="2" VerticalAlignment="Center">
          <TextBlock Text="PILOT CAPTURE" FontSize="14" FontWeight="Bold" Foreground="White" />
          <TextBlock Text="0.1 · FIRST FLIGHT" FontSize="12" Foreground="#D7E3F2" />
        </StackPanel>
      </StackPanel>
    </Border>

    <TabControl x:Name="MainTabs" Grid.Row="1" Margin="20">
      <TabItem Header="Roster">
      <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" RowSpacing="14">
      <Grid Grid.Row="0" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="14" RowSpacing="10">
        <StackPanel Spacing="5">
          <TextBlock Text="Roster intake" FontSize="26" FontWeight="SemiBold" />
          <TextBlock Text="Review the column mapping and possible name matches before saving the roster locally." TextWrapping="Wrap" Opacity="0.75" />
        </StackPanel>
        <Button Grid.Column="1" x:Name="OpenRosterButton" Content="Choose roster CSV…" Padding="18,10" VerticalAlignment="Center" Click="OnOpenRosterClick" />
        <TextBox Grid.Row="1" x:Name="EventName" PlaceholderText="Event name (required)" />
        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="8">
          <Button Classes="primary-action" x:Name="ImportRosterButton" Content="Import roster" Padding="18,8" IsEnabled="False" Click="OnImportRosterClick" />
        </StackPanel>
      </Grid>

      <Border Grid.Row="1" Padding="16" CornerRadius="8" BorderBrush="#DCE3ED" Background="White" BorderThickness="1">
        <StackPanel Spacing="12">
          <TextBlock Text="Column mapping" FontSize="18" FontWeight="SemiBold" />
          <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto" ColumnSpacing="14" RowSpacing="10">
            <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4">
              <TextBlock Text="First name" />
              <ComboBox x:Name="FirstNameColumn" IsEnabled="False" SelectionChanged="OnColumnMappingChanged" />
            </StackPanel>
            <StackPanel Grid.Row="0" Grid.Column="1" Spacing="4">
              <TextBlock Text="Last name" />
              <ComboBox x:Name="LastNameColumn" IsEnabled="False" SelectionChanged="OnColumnMappingChanged" />
            </StackPanel>
            <StackPanel Grid.Row="0" Grid.Column="2" Spacing="4">
              <TextBlock Text="Team / school" />
              <ComboBox x:Name="TeamOrSchoolColumn" IsEnabled="False" SelectionChanged="OnColumnMappingChanged" />
            </StackPanel>
            <StackPanel Grid.Row="1" Grid.Column="0" Spacing="4">
              <TextBlock Text="Sport / group" />
              <ComboBox x:Name="SportOrGroupColumn" IsEnabled="False" SelectionChanged="OnColumnMappingChanged" />
            </StackPanel>
            <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
              <TextBlock Text="Roster number" />
              <ComboBox x:Name="RosterNumberColumn" IsEnabled="False" SelectionChanged="OnColumnMappingChanged" />
            </StackPanel>
            <StackPanel Grid.Row="1" Grid.Column="2" Spacing="4">
              <TextBlock Text="Class / category (preserved)" />
              <ComboBox x:Name="ClassOrCategoryColumn" IsEnabled="False" SelectionChanged="OnColumnMappingChanged" />
            </StackPanel>
          </Grid>
        </StackPanel>
      </Border>

      <StackPanel Grid.Row="2" Spacing="4">
        <TextBlock x:Name="RosterSummary" FontWeight="SemiBold" Text="Choose a CSV file to start a preview." />
        <TextBlock x:Name="RosterWarnings" TextWrapping="Wrap" Foreground="#8A4B00" />
      </StackPanel>

      <Border Grid.Row="3" Padding="12" CornerRadius="8" BorderBrush="#D0D0D0" BorderThickness="1" MaxHeight="140">
        <StackPanel Spacing="6">
          <TextBlock Text="Review possible same-name matches (unchecked by default)" FontWeight="SemiBold" />
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="MatchReviewPanel" Spacing="3" />
          </ScrollViewer>
        </StackPanel>
      </Border>

      <Border Grid.Row="4" Padding="12" CornerRadius="8" BorderBrush="#D0D0D0" BorderThickness="1">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
          <ItemsControl x:Name="RosterPreviewRows">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding}" FontFamily="monospace" Margin="2,4" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Border>
      </Grid>
      </TabItem>

      <TabItem Header="Capture">
        <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="14" Margin="12">
          <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
            <StackPanel Spacing="5">
              <TextBlock Text="Capture setup" FontSize="26" FontWeight="SemiBold" />
              <TextBlock Text="Start an offline session, select a rostered subject, add a partially identified subject, or create an unidentified subject. Pilot Capture watches Smart Shooter 5's output folder and copies new JPEGs into local managed storage." TextWrapping="Wrap" Opacity="0.75" />
            </StackPanel>
            <Button Grid.Column="1" x:Name="ExportRosterButton" Content="Export new roster…" Padding="14,8" VerticalAlignment="Center" IsEnabled="False" Click="OnExportRosterClick" />
            <Button Grid.Column="2" x:Name="ExportAssociationsButton" Content="Export image associations…" Padding="14,8" VerticalAlignment="Center" IsEnabled="False" Click="OnExportImageAssociationsClick" />
          </Grid>

          <Border Grid.Row="1" Padding="16" CornerRadius="8" BorderBrush="#D0D0D0" BorderThickness="1">
            <Grid ColumnDefinitions="*,*,*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="10">
              <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4">
                <TextBlock Text="Event" />
                <ComboBox x:Name="CaptureEventCombo" SelectionChanged="OnCaptureEventChanged" />
              </StackPanel>
              <StackPanel Grid.Row="0" Grid.Column="1" Spacing="4">
                <TextBlock Text="Group / team" />
                <ComboBox x:Name="CaptureGroupCombo" SelectionChanged="OnCaptureGroupChanged" />
              </StackPanel>
              <StackPanel Grid.Row="0" Grid.Column="2" Spacing="4">
                <TextBlock Text="Photographer" />
                <TextBox x:Name="PhotographerName" PlaceholderText="Photographer name" />
              </StackPanel>
              <Button Grid.Row="0" Grid.Column="3" Classes="primary-action" x:Name="StartSessionButton" Content="Start session" Padding="16,8" VerticalAlignment="Bottom" Click="OnStartSessionClick" />

              <StackPanel Grid.Row="1" Grid.Column="0" Spacing="4">
                <TextBlock Text="Workflow" />
                <ComboBox x:Name="WorkflowTypeCombo" />
              </StackPanel>
              <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
                <TextBlock Text="Capture station" />
                <ComboBox x:Name="StationCodeCombo" SelectionChanged="OnStationCodeChanged" />
              </StackPanel>
              <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" x:Name="SessionStatus" VerticalAlignment="Center" Text="No active capture session." TextWrapping="Wrap" />
              <Button Grid.Row="2" Grid.Column="3" x:Name="EndSessionButton" Content="End session" Padding="16,8" IsEnabled="False" Click="OnEndSessionClick" />
            </Grid>
          </Border>

          <Border Grid.Row="2" Padding="12" CornerRadius="8" BorderBrush="#D0D0D0" BorderThickness="1">
            <Grid ColumnDefinitions="*,Auto,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="8">
              <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4">
                <TextBlock Text="Smart Shooter 5 JPEG output folder" FontWeight="SemiBold" />
              <TextBox x:Name="SmartShooterFolderPath" IsReadOnly="True" PlaceholderText="Choose the folder Smart Shooter writes JPEGs into" />
              </StackPanel>
              <Button Grid.Row="0" Grid.Column="1" Content="Choose folder…" Padding="14,8" VerticalAlignment="Bottom" Click="OnChooseSmartShooterFolderClick" />
              <Button Grid.Row="0" Grid.Column="2" x:Name="MonitorFolderButton" Content="Start monitoring" Padding="14,8" VerticalAlignment="Bottom" IsEnabled="False" Click="OnMonitorFolderClick" />
              <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" x:Name="ImageIngestStatus" Text="Original files stay in the Smart Shooter folder; Pilot Capture copies each JPEG into managed storage." TextWrapping="Wrap" Opacity="0.78" />
            </Grid>
          </Border>

          <Grid Grid.Row="3" ColumnDefinitions="*,*" ColumnSpacing="14">
            <Border Grid.Column="0" Padding="16" CornerRadius="8" BorderBrush="#D0D0D0" BorderThickness="1">
              <StackPanel Spacing="10">
                <TextBlock Text="Rostered subject" FontSize="18" FontWeight="SemiBold" />
                <ComboBox x:Name="CaptureSubjectCombo" />
                <Button Classes="primary-action" x:Name="SelectSubjectButton" Content="Select subject for capture" IsEnabled="False" Padding="14,8" HorizontalAlignment="Left" Click="OnSelectSubjectClick" />
                <TextBlock x:Name="SelectedCaptureSubject" Text="No subject selected." TextWrapping="Wrap" />
              </StackPanel>
            </Border>
            <Border Grid.Column="1" Padding="16" CornerRadius="8" BorderBrush="#D0D0D0" BorderThickness="1">
              <StackPanel Spacing="8">
                <TextBlock Text="Add a subject" FontSize="18" FontWeight="SemiBold" />
                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="6">
                  <TextBox Grid.Row="0" Grid.Column="0" x:Name="ManualFirstName" PlaceholderText="First name (optional)" />
                  <TextBox Grid.Row="0" Grid.Column="1" x:Name="ManualLastName" PlaceholderText="Last name (optional)" />
                  <TextBox Grid.Row="1" Grid.Column="0" x:Name="ManualRosterNumber" PlaceholderText="Roster number (optional)" />
                  <TextBox Grid.Row="1" Grid.Column="1" x:Name="ManualRole" PlaceholderText="Class / category (optional)" />
                </Grid>
                <Button Classes="primary-action" x:Name="CreateManualSubjectButton" Content="Add and select subject" IsEnabled="False" Padding="14,8" HorizontalAlignment="Left" Click="OnCreateManualSubjectClick" />
                <TextBlock Text="Enter the details you know. Choose a group above to save its roster number or category." TextWrapping="Wrap" Opacity="0.75" />
                <Border Height="1" Background="#DCE3ED" Margin="0,2" />
                <TextBlock Text="Unidentified subject" FontWeight="SemiBold" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <TextBox Grid.Column="0" x:Name="UnidentifiedSubjectName" PlaceholderText="Temporary label, such as Walk-in 1" />
                  <Button Grid.Column="1" Classes="forward-action" x:Name="CreateUnidentifiedButton" Content="Add unidentified" IsEnabled="False" Padding="14,8" Click="OnCreateUnidentifiedClick" />
                </Grid>
              </StackPanel>
            </Border>
          </Grid>
        </Grid>
      </TabItem>

      <TabItem x:Name="ImageReviewTab" Header="Image review">
        <Grid ColumnDefinitions="230,*" RowDefinitions="Auto,Auto,*" ColumnSpacing="14" RowSpacing="12" Margin="12">
          <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Spacing="4">
            <TextBlock x:Name="ReviewSubjectTitle" Text="Image review" FontSize="26" FontWeight="SemiBold" />
            <TextBlock x:Name="ReviewStatus" Text="Select a subject in Capture to begin. Imported originals remain unchanged." TextWrapping="Wrap" Opacity="0.78" />
          </StackPanel>

          <ListBox x:Name="CaptureImagesList" Grid.Row="1" Grid.RowSpan="2" Grid.Column="0" SelectionChanged="OnReviewImageSelectionChanged" ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="local:CaptureImageReviewRow">
                <StackPanel Width="194" Spacing="5" Margin="4">
                  <Image Source="{Binding Thumbnail}" Height="118" Stretch="Uniform" />
                  <TextBlock Text="{Binding Caption}" TextWrapping="Wrap" FontSize="12" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="8">
            <Button x:Name="SetPrimaryButton" Content="Set Primary" Padding="14,8" IsEnabled="False" Click="OnSetPrimaryClick" />
            <Button x:Name="ToggleBannerButton" Content="Mark Banner" Padding="14,8" IsEnabled="False" Click="OnToggleBannerClick" />
            <Button x:Name="RejectImageButton" Content="Reject" Padding="14,8" IsEnabled="False" Click="OnRejectImageClick" />
            <Button Classes="forward-action" x:Name="NextSubjectButton" Content="Next subject" Padding="14,8" IsEnabled="False" Click="OnNextSubjectClick" />
          </StackPanel>

          <Border Grid.Row="2" Grid.Column="1" Padding="10" CornerRadius="8" BorderBrush="#D0D0D0" BorderThickness="1">
            <Grid RowDefinitions="*,Auto" RowSpacing="8">
              <Image x:Name="SelectedImagePreview" Stretch="Uniform" />
              <TextBlock Grid.Row="1" x:Name="SelectedImageStatus" Text="Choose a thumbnail to preview." TextWrapping="Wrap" Opacity="0.78" />
            </Grid>
          </Border>
        </Grid>
      </TabItem>
    </TabControl>
  </Grid>
</Window>
